{
  "name": "ha-what-happened-card",
  "version": "0.1.0",
  "description": "Timeline card for Home Assistant that tells what happened, when, why and who caused it.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
