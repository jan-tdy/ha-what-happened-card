    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@types/node": "^26.6.6",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
